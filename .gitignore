.env
.env.local
.env.*.local
.env.production
.env.development
.dev.vars*

# ── BE specific ──────────────────────────────
BE/vdogen-e3f9070cfa09.json
BE/generated/
# BE/prompts/: ignore prompt iterations, but keep the eval harness + docs
BE/prompts/*
!BE/prompts/eval/
!BE/prompts/*.md

# ── FE specific ──────────────────────────────
FE/.wrangler/
FE/dist/
FE/dist-ssr/


# ── Build outputs ────────────────────────────
build/
dist/
.next/
out/

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

